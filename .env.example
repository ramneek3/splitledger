# Copy to .env for local development. Never commit the real .env.

# PostgreSQL connection string (docker-compose exposes Postgres on 5433)
DATABASE_URL=postgres://splitledger:splitledger@localhost:5433/splitledger
# Set to true for hosted Postgres that requires TLS (Neon, Render external URL, ...)
DATABASE_SSL=false

# Long random string used to sign session tokens. Generate: openssl rand -hex 32
JWT_SECRET=change-me

# Optional AI for quick add. Without any key a built-in rule-based parser is used.
# AI_PROVIDER: openrouter | anthropic | none. Leave empty to use whichever key is set
# (OpenRouter first).
AI_PROVIDER=
# OpenRouter (free models end in ":free"): https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Anthropic Claude (paid): https://console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

PORT=4000
