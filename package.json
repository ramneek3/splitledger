{
  "name": "splitledger",
  "version": "1.0.0",
  "private": true,
  "description": "Shared-expense ledger for flatmates, trips and student groups",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "npm run dev --workspace server & npm run dev --workspace client",
    "build": "npm run build --workspace client",
    "start": "npm run start --workspace server",
    "migrate": "npm run migrate --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm test --workspace server"
  },
  "engines": {
    "node": ">=20"
  }
}
